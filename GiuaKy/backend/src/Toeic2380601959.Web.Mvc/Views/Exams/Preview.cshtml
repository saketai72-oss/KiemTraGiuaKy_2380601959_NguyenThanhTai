@model Toeic2380601959.Toeic.Exam
@{
    ViewData["Title"] = "Xem trước & Chỉnh sửa - " + Model.Title;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Exams")">Quản lý Đề thi</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Xem trước & Chỉnh sửa</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-0">@Model.Title</h3>
            <span class="badge badge-primary me-2"><i class="fas fa-clock me-1"></i>@Model.DurationMinutes phút</span>
            <span class="badge badge-info me-2"><i class="fas fa-question-circle me-1"></i>@Model.TotalQuestions câu</span>
            <span class="badge @(Model.IsPublished ? "badge-success" : "badge-secondary")">
                @(Model.IsPublished ? "Đang mở thi" : "Đã đóng ca")
            </span>
        </div>
        <div>
            <a href="@Url.Action("Index", "Exams")" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left me-1"></i>Quay lại
            </a>
            <a href="@Url.Action("Analytics", "Exams", new { id = Model.Id })" class="btn btn-outline-success">
                <i class="fas fa-chart-bar me-1"></i>Xem Thống kê
            </a>
        </div>
    </div>

    <!-- Nav tabs Part 5, 6, 7 -->
    <ul class="nav nav-pills mb-4" id="partTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold px-4" id="part5-tab" data-toggle="pill" data-target="#part5" type="button" role="tab">
                Part 5 (Câu 101 - 130)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4" id="part6-tab" data-toggle="pill" data-target="#part6" type="button" role="tab">
                Part 6 (Câu 131 - 146)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4" id="part7-tab" data-toggle="pill" data-target="#part7" type="button" role="tab">
                Part 7 (Câu 147 - 200)
            </button>
        </li>
    </ul>

    <!-- Tab contents -->
    <div class="tab-content" id="partTabsContent">
        @foreach (var partNum in new[] { 5, 6, 7 })
        {
            var isPartActive = partNum == 5 ? "show active" : "";
            var groups = Model.QuestionGroups.Where(g => g.PartNumber == partNum).OrderBy(g => g.OrderIndex).ToList();

            <div class="tab-pane fade @isPartActive" id="part@(partNum)" role="tabpanel">
                @if (!groups.Any())
                {
                    <div class="alert alert-warning">Không có câu hỏi nào thuộc Part @partNum.</div>
                }
                else
                {
                    @foreach (var group in groups)
                    {
                        <div class="card shadow-sm border-0 mb-4 rounded-3">
                            @if (!string.IsNullOrWhiteSpace(group.PassageContentHtml))
                            {
                                <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <span class="badge badge-primary me-2">Bài đọc / Đoạn văn</span>
                                        <strong class="text-dark">@(group.DirectionText ?? $"Nhóm câu hỏi Part {group.PartNumber}")</strong>
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary btn-edit-passage"
                                            data-id="@group.Id"
                                            data-direction="@group.DirectionText"
                                            data-passage="@group.PassageContentHtml">
                                        <i class="fas fa-pencil-alt me-1"></i>Sửa bài đọc
                                    </button>
                                </div>
                                <div class="card-body bg-light p-4 border-bottom">
                                    <div class="passage-box p-3 bg-white rounded border" style="white-space: pre-wrap; font-family: inherit;">
                                        @group.PassageContentHtml
                                    </div>
                                </div>
                            }

                            <div class="card-body p-4">
                                <div class="row">
                                    @foreach (var q in group.Questions.OrderBy(q => q.QuestionNumber))
                                    {
                                        var optA = q.Options.FirstOrDefault(o => o.OptionLabel == "A");
                                        var optB = q.Options.FirstOrDefault(o => o.OptionLabel == "B");
                                        var optC = q.Options.FirstOrDefault(o => o.OptionLabel == "C");
                                        var optD = q.Options.FirstOrDefault(o => o.OptionLabel == "D");
                                        var correctOpt = q.Options.FirstOrDefault(o => o.IsCorrect)?.OptionLabel ?? "";

                                        <div class="col-md-6 mb-3" id="question-card-@q.Id">
                                            <div class="p-3 border rounded bg-white h-100 d-flex flex-column justify-content-between shadow-sm">
                                                <div>
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="fw-bold text-primary mb-0">Câu @q.QuestionNumber</h6>
                                                        <button class="btn btn-sm btn-outline-secondary btn-edit-question"
                                                                data-id="@q.Id"
                                                                data-number="@q.QuestionNumber"
                                                                data-text="@q.QuestionText"
                                                                data-opta="@(optA?.OptionText ?? "")"
                                                                data-optb="@(optB?.OptionText ?? "")"
                                                                data-optc="@(optC?.OptionText ?? "")"
                                                                data-optd="@(optD?.OptionText ?? "")"
                                                                data-key="@correctOpt"
                                                                data-hint="@(q.Hint ?? "")">
                                                            <i class="fas fa-pencil-alt"></i> Sửa
                                                        </button>
                                                    </div>
                                                    <p class="mb-3 text-dark q-text-display">@q.QuestionText</p>
                                                    <div class="list-group list-group-flush small mb-3">
                                                        @foreach (var opt in q.Options.OrderBy(o => o.OptionLabel))
                                                        {
                                                            <div class="list-group-item px-2 py-1 border-0 d-flex align-items-center @(opt.IsCorrect ? "bg-success text-white font-weight-bold rounded" : "")">
                                                                <span class="badge @(opt.IsCorrect ? "badge-light text-success" : "badge-light border") me-2 mr-2">@opt.OptionLabel</span>
                                                                <span>@opt.OptionText</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(q.Hint))
                                                {
                                                    <div class="bg-light p-2 rounded small text-muted border">
                                                        <i class="fas fa-lightbulb text-warning me-1"></i><strong>Giải thích:</strong> @q.Hint
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

<!-- Modal Chỉnh sửa Câu hỏi -->
<div class="modal fade" id="editQuestionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="editQuestionModalTitle">Chỉnh sửa Câu hỏi</h5>
                <button type="button" class="btn-close close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="editQuestionForm">
                    <input type="hidden" id="editQuestionId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nội dung Câu hỏi:</label>
                        <textarea class="form-control" id="editQuestionText" rows="3" required></textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-semibold">Đáp án A:</label>
                            <input type="text" class="form-control" id="editOptionA" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-semibold">Đáp án B:</label>
                            <input type="text" class="form-control" id="editOptionB" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-semibold">Đáp án C:</label>
                            <input type="text" class="form-control" id="editOptionC" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label fw-semibold">Đáp án D:</label>
                            <input type="text" class="form-control" id="editOptionD" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Đáp án Đúng:</label>
                        <select class="form-control" id="editKey">
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Gợi ý / Giải thích (Hint):</label>
                        <textarea class="form-control" id="editHint" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveQuestion">Lưu Thay Đổi</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa Bài đọc -->
<div class="modal fade" id="editPassageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Chỉnh sửa Nội dung Bài đọc</h5>
                <button type="button" class="btn-close close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="editPassageForm">
                    <input type="hidden" id="editGroupId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tiêu đề / Dẫn nhập đoạn văn:</label>
                        <input type="text" class="form-control" id="editDirectionText" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nội dung đoạn văn:</label>
                        <textarea class="form-control" id="editPassageContent" rows="10"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSavePassage">Lưu Bài Đọc</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModalById(id) {
            var el = document.getElementById(id);
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(el).show();
            } else if (window.jQuery && $(el).modal) {
                $(el).modal('show');
            }
        }

        function closeModalById(id) {
            var el = document.getElementById(id);
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                var inst = bootstrap.Modal.getInstance(el);
                if (inst) inst.hide();
            }
            if (window.jQuery && $(el).modal) {
                $(el).modal('hide');
            }
        }

        $(document).ready(function () {
            $('[data-dismiss="modal"], [data-bs-dismiss="modal"]').on('click', function (e) {
                e.preventDefault();
                var modal = $(this).closest('.modal');
                if (modal.length) {
                    closeModalById(modal.attr('id'));
                }
            });

            // Open Edit Question Modal
            $('.btn-edit-question').click(function () {
                var btn = $(this);
                $('#editQuestionId').val(btn.data('id'));
                $('#editQuestionModalTitle').text('Chỉnh sửa Câu ' + btn.data('number'));
                $('#editQuestionText').val(btn.data('text'));
                $('#editOptionA').val(btn.data('opta'));
                $('#editOptionB').val(btn.data('optb'));
                $('#editOptionC').val(btn.data('optc'));
                $('#editOptionD').val(btn.data('optd'));
                $('#editKey').val(btn.data('key'));
                $('#editHint').val(btn.data('hint'));
                openModalById('editQuestionModal');
            });

            // Save Question AJAX
            $('#btnSaveQuestion').click(function () {
                var payload = {
                    questionId: parseInt($('#editQuestionId').val()),
                    questionText: $('#editQuestionText').val(),
                    optionA: $('#editOptionA').val(),
                    optionB: $('#editOptionB').val(),
                    optionC: $('#editOptionC').val(),
                    optionD: $('#editOptionD').val(),
                    key: $('#editKey').val(),
                    hint: $('#editHint').val()
                };

                $.ajax({
                    url: '@Url.Action("UpdateQuestion", "Exams")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            closeModalById('editQuestionModal');
                            alert('Cập nhật câu hỏi thành công!');
                            location.reload();
                        } else {
                            alert(res.message || 'Lỗi khi cập nhật câu hỏi');
                        }
                    }
                });
            });

            // Open Edit Passage Modal
            $('.btn-edit-passage').click(function () {
                var btn = $(this);
                $('#editGroupId').val(btn.data('id'));
                $('#editDirectionText').val(btn.data('direction'));
                $('#editPassageContent').val(btn.data('passage'));
                openModalById('editPassageModal');
            });

            // Save Passage AJAX
            $('#btnSavePassage').click(function () {
                var payload = {
                    groupId: parseInt($('#editGroupId').val()),
                    directionText: $('#editDirectionText').val(),
                    passageContentHtml: $('#editPassageContent').val()
                };

                $.ajax({
                    url: '@Url.Action("UpdatePassage", "Exams")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            closeModalById('editPassageModal');
                            alert('Cập nhật bài đọc thành công!');
                            location.reload();
                        } else {
                            alert(res.message || 'Lỗi khi cập nhật bài đọc');
                        }
                    }
                });
            });
        });
    </script>
}
